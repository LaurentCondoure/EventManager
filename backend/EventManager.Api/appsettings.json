{
  "ConnectionStrings": {
    "DefaultConnection": "*** configured via user secrets ***",
    "IdentityConnection": "*** configured via user secrets ***"
  },
  "Jwt": {
    "Secret": "*** configured via environment variable ***",
    "Issuer": "EventManager",
    "Audience": "EventManager",
    "AccessTokenTtlMinutes": 10,
    "RefreshTokenTtlHours": 8
  },
  "ApiKey": {
    "Value": "*** configured via environment variable ***"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "TimeToLive": 10 // in minutes
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "EventsDB"
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:8080" ]
  },
  "RateLimiter": {
    "PermitLimit": 50,
    "WindowMinutes": 1,
    "QueueLimit": 0
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/eventmanager-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
